# Шаблон окружения frontend. Скопируйте в .env и подставьте свой домен.

# Базовый URL API с точки зрения БРАУЗЕРА. За nginx этого стека используйте
# относительный путь — запросы уйдут на тот же домен, nginx разрулит /api:
NUXT_PUBLIC_API_BASE=/api

# Либо абсолютный адрес (если фронт и API на разных хостах):
# NUXT_PUBLIC_API_BASE=https://chatra.example.com/api

# WebSocket-база (задаётся на будущее; код фронтенда пока не использует):
# NUXT_PUBLIC_WS_BASE=wss://chatra.example.com
