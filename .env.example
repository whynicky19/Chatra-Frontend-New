# Backend API base URL
NUXT_PUBLIC_API_BASE=http://localhost:8000/api

# WebSocket base URL  
NUXT_PUBLIC_WS_BASE=ws://localhost:8000

# Sentry (мониторинг ошибок). Пусто = выключен.
# DSN из Sentry → Settings → Client Keys (DSN).
# NUXT_PUBLIC_SENTRY_DSN=
# Окружение для фильтрации алертов: development / staging / production.
# NUXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Релиз (опционально): NUXT_PUBLIC_SENTRY_RELEASE=chatra-web@1.0.0
